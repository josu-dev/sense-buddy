# --- Core ---
PORT=8787
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787
DATABASE_PATH=./data/sense-buddy.db
# Mock OAuth (hackathon): mobile "Continue with Google/Apple" calls /api/dev/mock-login.
# Set to false in production, where real BetterAuth social providers below take over.
ALLOW_MOCK_AUTH=true
DAILY_TOKEN_BUDGET=60000

# --- Real OAuth (optional; enables BetterAuth social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Meta Model API (dev.meta.ai) — preferred live backend ---
# Get a key at dev.meta.ai → API keys (starts with LLM_). Same key works for
# chat (Muse Spark), SAM 3.1 segmentation and Voice Transcribe.
# When META_API_KEY (or MODEL_API_KEY) is set, it takes precedence over LLM_*.
#   Base URL : https://api.meta.ai/v1
#   Chat     : POST /chat/completions {model:"muse-spark-1.3", messages}
#   SAM 3.1  : POST /responses {model:"sam-3.1", input:[...]}
#   STT file : POST /asr/transcribe multipart {request, audio=wav mono 16/24kHz}
#   STT live : wss://api.meta.ai/v1/asr/realtime (fase 2 streaming)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_VISION_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_ASR_MODEL=muse-voice-transcribe-1.0

# --- Generic OpenAI-compatible fallback (OpenRouter/Together/Groq) ---
# Also used for speech-to-text (/audio/transcriptions, whisper) when META key
# cannot process a clip (e.g. no ffmpeg to convert m4a→WAV on the server).
LLM_STT_MODEL=whisper-large-v3-turbo
#   OpenRouter : https://openrouter.ai/api/v1        models: meta-llama/llama-4-scout, meta-llama/llama-3.3-70b-instruct
#   Together   : https://api.together.xyz/v1         models: meta-llama/Llama-4-Scout-17B-16E-Instruct
#   Groq       : https://api.groq.com/openai/v1      models: meta-llama/llama-4-scout-17b-16e-instruct
# Leave LLM_API_KEY empty to run in fully-mocked demo mode.
LLM_API_KEY=LLM_1817828469266012_oA_EqoltXu2mZQZcvHbZNhdEGK0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_VISION_MODEL=meta-llama/llama-4-scout
LLM_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct

# SAM 3 segmentation endpoint (optional). Any HTTPS endpoint accepting
# { image: dataUrl, prompt } and returning { objects: [{label, bbox, confidence}] }.
# e.g. a Replicate / fal.ai / self-hosted SAM 3 deployment. Without it, the
# pipeline falls back to Llama-vision-only grounding (engine: "llama-vision").
SAM3_API_URL=
SAM3_API_KEY=
