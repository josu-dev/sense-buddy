# --- Core ---
PORT=8787
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787
DATABASE_PATH=./data/sense-buddy.db
# Mock OAuth (hackathon): mobile "Continue with Google/Apple" calls /api/dev/mock-login.
# Set to false in production, where real BetterAuth social providers below take over.
ALLOW_MOCK_AUTH=true
DAILY_TOKEN_BUDGET=60000

# --- Real OAuth (optional; enables BetterAuth social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Meta models (live mode) ---
# No public "Meta API" exists for Llama/SAM 3: Meta models are served by
# OpenAI-compatible hosts. Point this at any of them — keys never reach the client.
#   OpenRouter : https://openrouter.ai/api/v1        models: meta-llama/llama-4-scout, meta-llama/llama-3.3-70b-instruct
#   Together   : https://api.together.xyz/v1         models: meta-llama/Llama-4-Scout-17B-16E-Instruct
#   Groq       : https://api.groq.com/openai/v1      models: meta-llama/llama-4-scout-17b-16e-instruct
# Leave LLM_API_KEY empty to run in fully-mocked demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_VISION_MODEL=meta-llama/llama-4-scout
LLM_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct

# SAM 3 segmentation endpoint (optional). Any HTTPS endpoint accepting
# { image: dataUrl, prompt } and returning { objects: [{label, bbox, confidence}] }.
# e.g. a Replicate / fal.ai / self-hosted SAM 3 deployment. Without it, the
# pipeline falls back to Llama-vision-only grounding (engine: "llama-vision").
SAM3_API_URL=
SAM3_API_KEY=
