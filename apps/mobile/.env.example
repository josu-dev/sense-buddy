# URL of the Sense Buddy API (apps/api). Use your machine's LAN IP on a real
# device, 10.0.2.2 on the Android emulator, localhost on iOS simulator/web.
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Real Google sign-in (optional; needs a dev build, NOT Expo Go) ---
# One OAuth client per platform from the same Google Cloud project
# (console.cloud.google.com → APIs & Services → Credentials). The app opens
# Google in a browser tab, gets an ID token, and the API verifies it.
# Allowlist the redirect URI `sensebuddy://auth` for each client.
# Without these, "Continue with Google" uses a demo account (with a notice).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
