{
  "expo": {
    "name": "Sense Buddy",
    "slug": "sense-buddy",
    "scheme": "sensebuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sensebuddy",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt",
          "fr"
        ]
      }
    },
    "android": {
      "package": "app.sensebuddy",
      "adaptiveIcon": {
        "backgroundColor": "#060D14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://192.168.0.93:8787",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "258da071-44a5-4c72-9c8a-4d37ac8edb8c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Sense Buddy uses your camera to see the world for you and describe where things are.",
          "microphonePermission": "Sense Buddy uses your microphone to hear important sounds for you.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sense Buddy needs the microphone to hear sirens, doorbells and your name for you.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "pt",
            "fr"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060D14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#060D14"
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
