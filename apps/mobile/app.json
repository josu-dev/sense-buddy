{
  "expo": {
    "name": "Sense Buddy",
    "slug": "sense-buddy",
    "scheme": "sensebuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.sensebuddy" },
    "android": {
      "package": "app.sensebuddy",
      "adaptiveIcon": {
        "backgroundColor": "#060D14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "extra": { "apiUrl": "http://localhost:8787" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      ["expo-camera", { "cameraPermission": "Sense Buddy uses your camera to see the world for you and describe where things are.", "microphonePermission": "Sense Buddy uses your microphone to hear important sounds for you.", "recordAudioAndroid": true }]
    ]
  }
}
